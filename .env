# TRACKED on purpose: `agents-cli deploy` copies this onto the engine, so it is the
# declared source for the deployed environment. Deploy MERGES — removing a key here
# does not remove it from a running engine. Secrets go in .env.secrets (gitignored).

# Supersedes GOOGLE_GENAI_USE_VERTEXAI; both are read, this one wins.
GOOGLE_GENAI_USE_ENTERPRISE=true

# The one value to change when cloning. Must match `project_id` in
# deployment/terraform/single-project/vars/env.tfvars; nothing enforces that.
# Local runs only — Agent Runtime reserves this key, so deploy strips it.
GOOGLE_CLOUD_PROJECT=tim-platform-lab

# Model endpoint, NOT the deployment region: `global` is a Gemini serving location.
GOOGLE_CLOUD_LOCATION=global

# Read by blueprint_agent/agent.py.
MODEL=gemini-3.5-flash-lite

# LLM-as-judge for `agents-cli eval`, read by tests/eval/response_quality.py. Separate
# from MODEL on purpose: a grader that moves with the agent makes scores incomparable.
JUDGE_MODEL=gemini-3.6-flash

# No telemetry keys here on purpose — service.tf owns them, and two would change local
# behaviour if added. See "Configuration" in README.md.
