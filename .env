# Settings for local runs. `agents-cli deploy` also copies them onto the deployed agent,
# so this file is where the deployed environment is declared.
#
# Deploy merges these values with what the agent already has. Deleting a key here does
# not delete it from a running agent.
#
# The file is tracked in git so the deployed configuration can be reviewed. Secrets go in
# .env.secrets, which is not tracked.

# Sends model calls through Agent Platform instead of the Gemini Developer API.
# This is the current name for GOOGLE_GENAI_USE_VERTEXAI; if both are set, this one wins.
GOOGLE_GENAI_USE_ENTERPRISE=true

# Project used by local runs, and the one value to change when adopting this repository.
# Keep it the same as `project_id` in deployment/terraform/single-project/vars/env.tfvars
# — nothing checks that for you.
#
# Deploy strips this key: Agent Runtime supplies the project itself.
GOOGLE_CLOUD_PROJECT=tim-platform-lab

# Where the model is served from — not where the agent is deployed. `global` routes to
# Gemini's multi-region endpoint. The agent's own region is set in vars/env.tfvars.
GOOGLE_CLOUD_LOCATION=global

# Model backing the agent, read by blueprint_agent/agent.py.
MODEL=gemini-3.5-flash-lite

# Model that grades eval runs, read by tests/eval/response_quality.py.
#
# It is kept separate from MODEL so that changing the agent's model does not also change
# the grader. A grader that moves makes scores from different runs incomparable.
JUDGE_MODEL=gemini-3.6-flash

# Telemetry is configured on the deployed agent, in
# deployment/terraform/single-project/service.tf, not here.
#
# Three of those settings also apply to local runs, so copying them into this file
# changes how the playground behaves. See "Configuration" in README.md.
