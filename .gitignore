# .env IS tracked, overriding the two ignores above — deploy treats it as the declared
# source for the engine's environment. Secrets and per-machine values stay in
# .env.secrets, which is not copied to the engine.
!.env
.env.secrets

# `agents-cli eval run` output. Keeping a baseline for `eval compare` means `git add -f`.
artifacts/

# `agents-cli deploy` output: the engine id and region it just wrote to. A local record
# of one deploy, not a description of the repo — Terraform owns the engine, and
# `--list` reports what is actually live.
deployment_metadata.json

# A2A Inspector
tools/a2a-inspector/

# Credentials and private keys
*.pem
*-key.json
credentials*.json

# Local coding-agent bridge (imports the committed AGENTS.md)
CLAUDE.md

# Local build notes, not part of the reference implementation
docs/build-log.md
docs/findings.md
docs/divergences.md

# Diagram sets belong in ../platform-diagrams, but tools write them here. Ignored so a
# stray set cannot ride along in `git add -A`; move it out rather than tracking it.
docs/diagrams/
