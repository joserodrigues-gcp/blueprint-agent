# Reference for the key set. `.env` itself is tracked in this repo, so there is
# nothing to copy — see "Configuration" in README.md.

# Supersedes GOOGLE_GENAI_USE_VERTEXAI; both are read, this one wins.
GOOGLE_GENAI_USE_ENTERPRISE=true

# Must match `project_id` in deployment/terraform/single-project/vars/env.tfvars.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Model endpoint, NOT the deployment region: `global` is a Gemini serving location.
GOOGLE_CLOUD_LOCATION=global

# Read by blueprint_agent/agent.py.
MODEL=gemini-3.5-flash-lite

# LLM-as-judge for `agents-cli eval`, read by tests/eval/response_quality.py.
JUDGE_MODEL=gemini-3.6-flash

# No telemetry keys here on purpose — service.tf owns them.

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
