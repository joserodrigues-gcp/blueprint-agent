# Template for .env — but note that .env itself is tracked in this repo, so this
# file is a reference for the key set rather than the thing you copy.

# Vertex AI configuration.
# GOOGLE_GENAI_USE_ENTERPRISE replaces the deprecated GOOGLE_GENAI_USE_VERTEXAI;
# google-genai and ADK both read the new name first and warn on the old one.
GOOGLE_GENAI_USE_ENTERPRISE=true

# The one value to change when cloning this repo.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Agent model. Read by blueprint_agent/agent.py; the default lives there too.
MODEL=gemini-3.5-flash-lite

# LLM-as-judge model for `agents-cli eval`. Read by tests/eval/response_quality.py;
# the default lives there too. Kept separate from MODEL on purpose — a grader that
# moves with the agent makes scores incomparable across runs.
JUDGE_MODEL=gemini-3.6-flash

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
